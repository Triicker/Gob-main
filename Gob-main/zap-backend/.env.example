# ============================================================
# .env.example — ATUALIZADO com novas variáveis
# Copie para .env e preencha com seus dados reais.
# NUNCA commite o .env real no repositório.
# ============================================================

# ───────────────────────────────────────────────────────────
# Z-API — Credenciais (pegar no painel https://app.z-api.io)
# ───────────────────────────────────────────────────────────
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID_AQUI
ZAPI_INSTANCE_TOKEN=SEU_TOKEN_AQUI
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN_AQUI

# ───────────────────────────────────────────────────────────
# WhatsApp — Número destino
# Formato: 55 + DDD + número (sem espaços/traços)
# Exemplo: 5511987380525
# ───────────────────────────────────────────────────────────
ZAP_PHONE=5511987380525

# ───────────────────────────────────────────────────────────
# Servidor
# ───────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ───────────────────────────────────────────────────────────
# CORS — Origens permitidas (separar por vírgula)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://basta.app.br,https://www.basta.app.br
# ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://basta.app.br

# ───────────────────────────────────────────────────────────
# Segurança — reCAPTCHA (opcional, mas recomendado)
# Criar em: https://www.google.com/recaptcha/admin
# ───────────────────────────────────────────────────────────
# RECAPTCHA_SITE_KEY=SUA_CHAVE_SITE_AQUI
# RECAPTCHA_SECRET_KEY=SUA_CHAVE_SECRETA_AQUI

# ───────────────────────────────────────────────────────────
# Monitoramento — Sentry (opcional)
# Criar em: https://sentry.io
# ───────────────────────────────────────────────────────────
# SENTRY_DSN=https://seu-hash@sentry.io/seu-projeto

# ───────────────────────────────────────────────────────────
# Redis — Para queue system (opcional, futuro)
# Upstash: https://upstash.com (FREE tier: 10k commands/day)
# ───────────────────────────────────────────────────────────
# REDIS_URL=redis://seu-redis-url

# ───────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────
LOG_LEVEL=info
ANONIMIZAR_LOGS=true
