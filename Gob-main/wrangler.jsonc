{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gob-main",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-05",
  "keep_vars": true,
  "vars": {
    "RESEND_FROM_EMAIL": "Instituto BASTA <contato@basta.app.br>",
    "RESEND_TO_EMAIL": "chegou.email.site@gmail.com"
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY"
    ]
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
