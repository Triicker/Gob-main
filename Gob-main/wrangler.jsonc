{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gob-main",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-05",
  "keep_vars": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
